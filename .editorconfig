# Editor basics for every editor; Rust formatting itself is rustfmt's.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 120

[*.rs]
indent_size = 4

[*.md]
# Two trailing spaces are a line break in Markdown.
trim_trailing_whitespace = false
max_line_length = 80

[*.{bat,cmd}]
end_of_line = crlf

[LICENSE]
# The CC0 legal code exactly as Creative Commons publishes it.
trim_trailing_whitespace = false
